# Configuração local do TutorIA (cliente do benchmark E2)
# URL pública/encaminhada do servidor vLLM, incluindo /v1 ou sem o sufixo.
VLLM_BASE_URL=https://SEU-TUNEL/v1
VLLM_API_KEY=SUBSTITUA_PELA_MESMA_CHAVE_DO_SERVIDOR
# Opcional: VRAM usada no servidor (MB), obtida no ambiente GPU.
# VLLM_VRAM_MB=12000

# O nome precisa ser idêntico ao --served-model-name do vLLM.
LLM_MODEL=llama-int8
LLM_BASE_URL=https://SEU-TUNEL/v1
LLM_API_KEY=SUBSTITUA_PELA_MESMA_CHAVE_DO_SERVIDOR
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=350
LLM_SLOW_THRESHOLD_S=60

# Configuração RAG
EMBEDDING_MODEL=BAAI/bge-m3
WEIGHT_EMBEDDING=0.80
WEIGHT_KEYWORDS=0.20
DUPLICATION_THRESHOLD=0.05
BASE_FOLDER=base
WINDOW_SIZE=3
chunk_SIZE=500
overlap=75
PERSIST_DIRECTORY=DataBase
PATH_DB=DataBase
temperature=0.0
DEFAULT_LLM_TIMEOUT_S=120
DEFAULT_LLM_MAX_TOKENS=350
DEFAULT_LLM_SLOW_THRESHOLD_S=60
k_retrieval=3
k_results=4
t=0.5

# Necessário somente para calcular as métricas RAGAS.
OPENROUTER_API_KEY=SUBSTITUA_PELA_SUA_CHAVE
RAGAS_JUDGE_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
