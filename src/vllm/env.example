# Copie para src/vllm/.env no host que executará o Docker Compose.
# Identificador do modelo no Hugging Face (substitua pelo repositório/artefato correto).
VLLM_MODEL=SUBSTITUA_PELO_MODELO_HF
# Nome exposto em /v1/models; deve ser exatamente llama-int8 ou mathstral-bf16.
VLLM_SERVED_NAME=llama-int8
VLLM_API_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE
HF_TOKEN=SEU_TOKEN_HF_SE_NECESSARIO
VLLM_VERSION=latest
VLLM_PORT=8000
LLM_MAX_LEN=8192
LLM_GPU_UTIL=0.90
# Argumentos adicionais do vLLM, se necessários para quantização/arquitetura.
LLM_EXTRA_ARGS=
